FROM almalinux:9
ENV HOME=/
RUN dnf update -y
RUN dnf install -y rpmdevtools dnf-plugins-core epel-release

RUN rpmdev-setuptree
RUN echo '%dist   .el9' >> /.rpmmacros
COPY ./rpmbuild/ /rpmbuild/
RUN chown -R root:root /rpmbuild
RUN dnf --enablerepo=crb builddep -y /rpmbuild/SPECS/mysql.spec
RUN spectool -g -R /rpmbuild/SPECS/mysql.spec && \
  rpmbuild -ba /rpmbuild/SPECS/mysql.spec && \
  tar -czf /tmp/mysql.tar.gz -C /rpmbuild RPMS SRPMS && \
  rm -rf /rpmbuild
CMD ["/bin/true"]
